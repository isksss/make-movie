{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://make-movie.dev/schema/plugin-lock.schema.json",
  "title": "make-movie Plugin Lock",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plugin": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "checksum", "path"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$|^sha256:unverified$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
